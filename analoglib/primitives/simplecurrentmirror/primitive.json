{
  "name": "simplecurrentmirror",
  "version": "1.0",
  "description": "Simple current mirror — single transistor per branch, NMOS or PMOS",
  "transistor_type": "pmos",
  "subckt_name": "simplecurrentmirror",
  "pin_order": ["VINP", "VOUTP", "VDD"],

  "small_signal": {
    "branches": [
      {
        "name": "m1",
        "vd": "VOUTP",
        "vg": "VINP",
        "vs": "VDD",
        "vb": "VDD"
      },
      {
        "name": "m2",
        "vd": "VINP",
        "vg": "VINP",
        "vs": "VDD",
        "vb": "VDD"
      }
    ]
  },

  "physical_model": {
    "lut_primitive": "currentmirror",
    "operating_point_branch": "m1",
    "ports": {
      "DOUT": "VOUTP",
      "DREF": "VINP",
      "S": "VDD",
      "B": "VDD"
    }
  },


  "ports": {
            "VINP":  { "name": "VINP",  "role": "INPUT",  "description": "Positive input" },
            "VOUTP": { "name": "VOUTP", "role": "OUTPUT", "description": "Positive output" },
            "VDD": { "name": "VDD", "role": "BIAS",   "description": "Vdd node" }
  },

  "ui": {
    "symbol": {
      "pins": [
        { "name": "VINP", "side": "bottom", "offset": 0.2 },
	{ "name": "VOUTP", "side": "bottom", "offset": 0.8 },
	{ "name": "VDD", "side": "top", "offset": 0.5 }
      ]
    }
  },

  "layout_params": [
    { "name": "W",    "unit": "m",   "computed": true,  "description": "Transistor width (set by build)" },
    { "name": "L",    "unit": "m",   "computed": false, "default": 4e-7, "description": "Gate length" },
    { "name": "nf",   "unit": "int", "computed": false, "default": 2,   "description": "Number of gate fingers" },
    { "name": "rows", "unit": "int", "computed": false, "default": 1,   "description": "Number of rows in array" }
  ],

  "lut_config": {
    "lut_w": 5e-6,
    "axes": [
      { "variable": "vds",   "values": [-1.2, -0.1], "type": "arange" },
      { "variable": "vgs", "values": [-1.2, -0.1], "type": "arange"  }
    ],
    "lengths": [4e-7, 8e-7, 1.6e-6, 3.2e-6, 6.4e-6]
  },

  "files": {
    "build":   "build.json",
    "netlist": "netlist/netlist.spice",
    "symbol":  "symbol/symbol.sym"
  }
}
