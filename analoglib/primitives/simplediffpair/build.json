{
  "inputs": [
    { "name": "current", "kind": "scalar", "required": true },
    { "name": "VINP", "kind": "vector", "required": true, "source": "port_voltage" },
    { "name": "VOUTP", "kind": "vector", "required": true, "source": "port_voltage" },
    { "name": "VTAIL", "kind": "vector", "required": true, "source": "port_voltage" }
  ],
  "sweep_mode": "cartesian",
  "derived": [
    { "name": "id_m1", "expr": "current / 2" },
    { "name": "vds_m1", "expr": "VOUTP - VTAIL" },
    { "name": "vgs_m1", "expr": "VINP - VTAIL" }
  ],
  "lut": [
    {
      "name": "m1",
      "device": "nmos",
      "current": "id_m1",
      "dof": {
        "vds": "vds_m1",
        "vgs": "vgs_m1"
      },
      "lengths": "$lut_config.lengths"
    }
  ],
  "columns": [
    { "name": "length__m1", "expr": "lut.m1.length" },
    { "name": "length__m2", "expr": "length__m1" },
    { "name": "width__m1", "expr": "lut.m1.total_width" },
    { "name": "width__m2", "expr": "width__m1" },
    { "name": "nf__m1", "expr": "lut.m1.nf" },
    { "name": "nf__m2", "expr": "nf__m1" },
    { "name": "gm__m1", "expr": "lut.m1.gmid * (id_m1)" },
    { "name": "gm__m2", "expr": "gm__m1" },
    { "name": "gds__m1", "expr": "lut.m1.gdsid * (id_m1)" },
    { "name": "gds__m2", "expr": "gds__m1" },
    { "name": "ro__m1", "expr": "1 / gds__m1" },
    { "name": "ro__m2", "expr": "ro__m1" },
    { "name": "cgg__m1", "expr": "lut.m1.cgg * lut.m1.nf" },
    { "name": "cgg__m2", "expr": "cgg__m1" },
    { "name": "cgd__m1", "expr": "lut.m1.cgd * lut.m1.nf" },
    { "name": "cgd__m2", "expr": "cgd__m1" },
    { "name": "cgs__m1", "expr": "lut.m1.cgs * lut.m1.nf" },
    { "name": "cgs__m2", "expr": "cgs__m1" },
    { "name": "cdg__m1", "expr": "lut.m1.cdg * lut.m1.nf" },
    { "name": "cdg__m2", "expr": "cdg__m1" },
    { "name": "cdd__m1", "expr": "lut.m1.cdd * lut.m1.nf" },
    { "name": "cdd__m2", "expr": "cdd__m1" },
    { "name": "cds__m1", "expr": "lut.m1.cds * lut.m1.nf" },
    { "name": "cds__m2", "expr": "cds__m1" },
    { "name": "csg__m1", "expr": "lut.m1.csg * lut.m1.nf" },
    { "name": "csg__m2", "expr": "csg__m1" },
    { "name": "csd__m1", "expr": "lut.m1.csd * lut.m1.nf" },
    { "name": "csd__m2", "expr": "csd__m1" },
    { "name": "css__m1", "expr": "lut.m1.css * lut.m1.nf" },
    { "name": "css__m2", "expr": "css__m1" },
    { "name": "cgsol__m1", "expr": "lut.m1.cgsol_total" },
    { "name": "cgsol__m2", "expr": "cgsol__m1" },
    { "name": "cgdol__m1", "expr": "lut.m1.cgdol_total" },
    { "name": "cgdol__m2", "expr": "cgdol__m1" },
    { "name": "cjs__m1", "expr": "lut.m1.cjs_total" },
    { "name": "cjs__m2", "expr": "cjs__m1" },
    { "name": "cjd__m1", "expr": "lut.m1.cjd_total" },
    { "name": "cjd__m2", "expr": "cjd__m1" }
  ]
}
