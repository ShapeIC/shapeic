{
  "name": "simplediffpair",
  "version": "1.0",
  "description": "Simple differential pair — single transistor per branch, NMOS or PMOS",
  "transistor_type": "nmos",
  "subckt_name": "simplediffpair",
  "pin_order": ["VINP", "VINN", "VOUTP", "VOUTN", "VTAIL", "VSS"],

  "small_signal": {
    "branches": [
      {
        "name": "m1",
        "vd": "VOUTP",
        "vg": "VINP",
        "vs": "VTAIL",
        "vb": "VSS"
      },
      {
        "name": "m2",
        "vd": "VOUTN",
        "vg": "VINN",
        "vs": "VTAIL",
        "vb": "VSS"
      }
    ]
  },

  "physical_model": {
    "lut_primitive": "simplediffpair",
    "operating_point_branch": "m1",
    "ports": {
      "DP": "VOUTP",
      "DN": "VOUTN",
      "GP": "VINP",
      "GN": "VINN",
      "S": "VTAIL",
      "B": "VSS"
    }
  },

  "ports": {
            "VINP":  { "name": "VINP",  "role": "INPUT",  "description": "Positive differential input" },
            "VINN":  { "name": "VINN",  "role": "INPUT",  "description": "Negative differential input" },
            "VOUTP": { "name": "VOUTP", "role": "OUTPUT", "description": "Positive output" },
            "VOUTN": { "name": "VOUTN", "role": "OUTPUT", "description": "Negative output" },
            "VTAIL": { "name": "VTAIL", "role": "BIAS",   "description": "Tail current source node" },
            "VSS":   { "name": "VSS",   "role": "SUPPLY", "description": "NMOS bulk connection" }
  },

  "ui": {
    "symbol": {
      "pins": [
        { "name": "VINP", "side": "right", "offset": 0.5 },
	{ "name": "VINN", "side": "left", "offset": 0.5 },
	{ "name": "VOUTP", "side": "top", "offset": 0.8 },
	{ "name": "VOUTN", "side": "top", "offset": 0.2 },
	{ "name": "VTAIL", "side": "bottom", "offset": 0.5 },
	{ "name": "VSS", "side": "bottom", "offset": 0.8 }
      ]
    }
  },

  "layout_params": [
    { "name": "W",    "unit": "m",   "computed": true,  "description": "Transistor width (set by build)" },
    { "name": "L",    "unit": "m",   "computed": false, "default": 4e-7, "description": "Gate length" },
    { "name": "nf",   "unit": "int", "computed": false, "default": 2,   "description": "Number of gate fingers" },
    { "name": "rows", "unit": "int", "computed": false, "default": 1,   "description": "Number of rows in array" }
  ],

  "lut_config": {
    "lut_w": 5e-6,
    "axes": [
      { "variable": "vds",   "values": [0.1, 1.2], "type": "arange" },
      { "variable": "vgs", "values": [0.1, 1.2], "type": "arange"  }
    ],
    "lengths": [4e-7, 8e-7, 1.6e-6, 3.2e-6, 6.4e-6]
  },

  "files": {
    "build":   "build.json",
    "netlist": "netlist/netlist.spice",
    "symbol":  "symbol/symbol.sym"
  }
}
